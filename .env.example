# Shared database (Supabase → Project Settings → API). With both set, every visitor sees the same records.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only used when the two values above are missing (local browser-only mode).
VITE_ADMIN_PASSCODE=admin
